<Window x:Class="PKS_sem4_kr3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="HTTP Monitor" Height="800" Width="1100"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="1" Background="#45475A" Width="2" Margin="0,10"/>
        
        <!-- LEFT PANEL - SERVER -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Border Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="HTTP SERVER" FontSize="18" FontWeight="Bold" Foreground="#89B4FA"/>
                        <TextBlock Text="HttpListener" FontSize="11" Foreground="#6C7086"/>
                    </StackPanel>
                    
                    <Border Grid.Column="1" Background="#181825" CornerRadius="5" Padding="10">
                        <WrapPanel>
                            <Border Background="#313244" CornerRadius="3" Padding="8,3" Margin="0,0,5,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="GET:" Foreground="#A6E3A1" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="txtGetCount" Text="0" Foreground="#CDD6F4" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#313244" CornerRadius="3" Padding="8,3" Margin="0,0,5,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="POST:" Foreground="#FAB387" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="txtPostCount" Text="0" Foreground="#CDD6F4" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#313244" CornerRadius="3" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Avg:" Foreground="#CBA6F7" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="txtAvgTime" Text="0ms" Foreground="#CDD6F4" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
            
            <Border Grid.Row="1" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PORT:" Foreground="#6C7086" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtPort" Text="8080" Width="60" TextAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnStart" Content="START" Click="btnStart_Click"/>
                        <Button x:Name="btnStop" Content="STOP" IsEnabled="False" Click="btnStop_Click" Background="#F38BA8"/>
                        
                        <Border Background="#45475A" CornerRadius="5" Padding="10,5" Margin="15,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="statusIndicator" Width="10" Height="10" Fill="#F38BA8" Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtStatus" Text="STOPPED" Foreground="#CDD6F4" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>
                
                <Border Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="LOGS" FontSize="14" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>
                        <ListBox x:Name="lstLogs" Grid.Row="1"/>
                    </Grid>
                </Border>
                
                <Border Grid.Row="1" Background="#313244" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="LOAD GRAPH" FontSize="14" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>
                        <oxy:PlotView x:Name="LoadChart" Grid.Row="1"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <!-- RIGHT PANEL - CLIENT -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Border Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <TextBlock Text="HTTP CLIENT" FontSize="18" FontWeight="Bold" Foreground="#89B4FA"/>
            </Border>
            
            <Border Grid.Row="1" Background="#313244" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="URL" Foreground="#6C7086" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtUrl" Text="http://localhost:8080/"/>
                            <ComboBox x:Name="cmbMethod" Grid.Column="1" Width="80" Margin="5,0" SelectedIndex="0">
                                <ComboBoxItem Content="GET"/>
                                <ComboBoxItem Content="POST"/>
                            </ComboBox>
                            <Button Grid.Column="2" Content="SEND" Click="btnSend_Click" Background="#A6E3A1"/>
                        </Grid>
                    </StackPanel>
                    
                    <GroupBox Grid.Row="1" Header="REQUEST BODY" Margin="0,15,0,10" Foreground="#CDD6F4">
                        <TextBox x:Name="txtBody" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#181825"/>
                    </GroupBox>
                    
                    <GroupBox Grid.Row="2" Header="RESPONSE" Foreground="#CDD6F4">
                        <TextBox x:Name="txtResponse" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#181825"/>
                    </GroupBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>